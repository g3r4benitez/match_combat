IS_DEBUG=True

# Database (SQLite)
# Relative paths resolve from the process working directory (the project root
# when running through PM2). Use an absolute path in production if preferred,
# e.g. sqlite:////var/lib/match_combat/match_combat.db
DB_URL="sqlite:///data/match_combat.db"
SQL_ECHO=False

# Celery
CELERY_BROKER_PROTOCOL=amqp
CELERY_BROKER_USERNAME=guest
CELERY_BROKER_PASSWORD=guest
CELERY_BROKER_HOST=localhost
CELERY_BROKER_PORT=5672
CELERY_BROKER_DB=''
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

PASSWORD_RESET_EXPIRE_HOURS=12
