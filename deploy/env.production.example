# Match Combat - production environment template.
#
# Copy to the project root as .env and edit before starting PM2:
#   cp deploy/env.production.example .env
#   chmod 600 .env
#
# app/core/config.py reads this file from the process working directory, which
# PM2 sets to the project root (see ecosystem.config.js).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
IS_DEBUG=False

# ---------------------------------------------------------------------------
# Database (SQLite)
#
# Relative paths resolve from the process working directory, which PM2 sets to
# the project root (see ecosystem.config.js). Use an absolute path if you prefer
# to keep the database outside the project, e.g.:
#   DB_URL=sqlite:////var/lib/match_combat/match_combat.db
# ---------------------------------------------------------------------------
DB_URL=sqlite:///data/match_combat.db
SQL_ECHO=False

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_HOURS=1

# ---------------------------------------------------------------------------
# Initial admin user (seeded on first startup)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@matchcombat.local

# ---------------------------------------------------------------------------
# Event
# ---------------------------------------------------------------------------
NOMBRE_EVENTO=Match Combat

# ---------------------------------------------------------------------------
# SMTP (optional, password-reset emails)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# ---------------------------------------------------------------------------
# S3 (optional, sponsors image for PDF footer)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
S3_SPONSORS_BUCKET=

# ---------------------------------------------------------------------------
# Celery (optional, not required by the API process)
# ---------------------------------------------------------------------------
CELERY_BROKER_PROTOCOL=amqp
CELERY_BROKER_USERNAME=guest
CELERY_BROKER_PASSWORD=guest
CELERY_BROKER_HOST=localhost
CELERY_BROKER_PORT=5672
CELERY_BROKER_DB=
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
